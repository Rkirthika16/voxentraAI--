# ==============================================================================
# VoxentraAI Configuration Environment File
# ==============================================================================

# Application Settings
APP_NAME=VoxentraAI
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
BASE_URL=http://127.0.0.1:8000

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./voxentra.db

# Speech-to-Text (Whisper) Settings
# Options: tiny, base, small, medium, large (default: base)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# Twilio Telephony Settings (Global)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_voxentra
TWILIO_AUTH_TOKEN=dummy_auth_token_voxentra
TWILIO_PHONE_NUMBER=+914422334455
TWILIO_MOCK_MODE=True

# Exotel India Cloud Telephony (Virtual Mobile Number & 1800 Toll-Free)
# Sign up at https://my.exotel.com/ to obtain credentials
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=08088919888

# Gemini AI (Optional - for advanced reasoning & classification)
GEMINI_API_KEY=

# Tamil Nadu Emergency Helpline Numbers
EMERGENCY_POLICE=100
EMERGENCY_AMBULANCE=108
EMERGENCY_DISASTER=1077
EMERGENCY_ELECTRICITY_TNEB=1912
EMERGENCY_GCC_CHENNAI=1913
EMERGENCY_WATER_CMWSSB=1916
